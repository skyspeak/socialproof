# x_reader: copy to .env (never commit it).

# --- X session. Either run `x_reader.py login` once, or paste the two cookies
# from your normal browser's x.com session.
# X_AUTH_TOKEN=
# X_CT0=

# --- Send new bookmarks to Trendwire (off while TRENDWIRE_URL is empty)
# TRENDWIRE_URL=https://duckfeet.vercel.app
# The same value as BOOKMARK_SECRET in Trendwire's Vercel settings
# (or CRON_SECRET, which it falls back to).
# TRENDWIRE_BOOKMARK_SECRET=
# TRENDWIRE_PUSH_LIMIT=15

# --- Summaries: ollama (local, free) | anthropic | none
# SUMMARY_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- The reading site
# SITE_TITLE=Your Digest
# SITE_MOTTO=All the bookmarks fit to read
# PDF_FORMAT=A5
# CF_PAGES_PROJECT=
# CF_KV_NOTES_ID=
