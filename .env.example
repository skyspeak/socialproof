# ---- Database -------------------------------------------------------------
# POOLED connection string — used by the app at runtime.
# On Neon this is the hostname containing "-pooler".
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT (unpooled) connection string — used ONLY by `npm run db:migrate`.
# Neon's pooled endpoint is PgBouncer in transaction mode and does not support
# the session-level statements DDL needs. Same host without "-pooler".
#
# If you attach Neon via the Vercel Marketplace integration, this is set for you
# as DATABASE_URL_UNPOOLED and you do not need to define anything here — the
# migrate script checks DATABASE_URL_UNPOOLED first.
DIRECT_DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Cron / tick auth -----------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations, and
# /api/tick requires the same. Generate with: openssl rand -hex 32
# NOTE: if this is unset in production, both routes fail closed with 401.
CRON_SECRET=""

# ---- Synthesis LLM --------------------------------------------------------
# Without a key the pipeline still publishes, but via heuristic term-clustering
# instead of editorial themes — noticeably worse. See README.
#
# Keys are tried in this order unless you pin with LLM_PROVIDER:
#   gemini → openrouter → anthropic → openai
# A failed hop continues to the next configured key.
#
# Pin one or a chain, e.g. LLM_PROVIDER=gemini  or  LLM_PROVIDER=gemini,openrouter
# LLM_PROVIDER=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides
GEMINI_MODEL="gemini-2.5-pro"
OPENROUTER_MODEL="google/gemini-2.5-pro"
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_MODEL="gpt-4o"

# Optional base-URL overrides (proxy, gateway, or a local stub for testing)
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# ANTHROPIC_BASE_URL=""
# OPENAI_BASE_URL=""

# ---- Optional source credentials ------------------------------------------
# Exa powers X-scoped semantic search and the Exa people-move pass.
# Without it those two sources report `skipped` and the X tier falls back to
# Techmeme + newsletters.
EXA_API_KEY=""

# ---- Site -----------------------------------------------------------------
# Used for RSS links and canonical URLs. Vercel's own VERCEL_URL is used as a
# fallback if this is unset.
NEXT_PUBLIC_SITE_URL="https://trendwire.example.com"
