# ---- Database (Supabase) --------------------------------------------------
# POOLED connection — used by the app at runtime on Vercel.
# Dashboard → Connect → Connection string → URI → Transaction pooler
# (host pooler.supabase.com, port 6543). Do not use the Prisma string.
DATABASE_URL="postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# DIRECT connection — used ONLY by `npm run db:migrate`.
# Dashboard → Connect → URI → Direct (db.<project>.supabase.co:5432).
# If that host is IPv6-only and migrate fails with ENETUNREACH, use the
# Session pooler instead (same pooler host, port 5432).
#
# If you attach Supabase via the Vercel Marketplace, POSTGRES_URL (pooled)
# and POSTGRES_URL_NON_POOLING (direct) are set for you; the app and migrate
# script both honor those names.
DIRECT_DATABASE_URL="postgres://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# ---- Cron / tick auth -----------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations, and
# /api/tick requires the same. Generate with: openssl rand -hex 32
# NOTE: if this is unset in production, both routes fail closed with 401.
CRON_SECRET=""

# ---- Synthesis LLM --------------------------------------------------------
# Without a key the pipeline still publishes, but via heuristic term-clustering
# instead of editorial themes — noticeably worse. See README.
#
# Keys are tried in this order unless you pin with LLM_PROVIDER:
#   gemini → openrouter → anthropic → openai
# A failed hop continues to the next configured key.
#
# Pin one or a chain, e.g. LLM_PROVIDER=gemini  or  LLM_PROVIDER=gemini,openrouter
# LLM_PROVIDER=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides
GEMINI_MODEL="gemini-2.5-pro"
OPENROUTER_MODEL="google/gemini-2.5-pro"
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_MODEL="gpt-4o"

# Optional base-URL overrides (proxy, gateway, or a local stub for testing)
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# ANTHROPIC_BASE_URL=""
# OPENAI_BASE_URL=""

# ---- Optional source credentials ------------------------------------------
# Exa powers X-scoped semantic search and the Exa people-move pass.
# Without it those two sources report `skipped` and the X tier falls back to
# Techmeme, Bluesky, and the newsletters.
EXA_API_KEY=""

# Optional: GitHub search from Vercel is often 403 without a token.
# A fine-grained PAT with public repository read is enough.
# GITHUB_TOKEN=""

# Optional: Reddit application-only OAuth so r/LocalLLaMA et al work from
# datacenter IPs. Create a "script" app at https://www.reddit.com/prefs/apps.
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# ---- Bookmarks ------------------------------------------------------------
# When you save a tweet (bookmarklet, shortcut, or native X bookmarks), Trendwire
# unpacks its outbound links and images into the next issue.
#
# Prefer a dedicated secret so a leaked bookmarklet cannot fire the digest cron.
# Generate with: openssl rand -hex 32
# BOOKMARK_SECRET=""
#
# Optional: ingest tweets you bookmark inside X itself. Needs a user-context
# OAuth 2.0 token with bookmark.read, plus your numeric user id.
# X_BOOKMARKS_TOKEN=""
# X_USER_ID=""

# ---- Site -----------------------------------------------------------------
# Used for RSS links and canonical URLs. Vercel's own VERCEL_URL is used as a
# fallback if this is unset.
NEXT_PUBLIC_SITE_URL="https://trendwire.example.com"
